[package]
name = "test_log_viewer"
version = "0.1.0"
edition = "2021"

[[bin]]
name = "test_log_viewer"
path = "test_log_viewer.rs"

[dependencies]
tiny_http = "0.12"
webbrowser = "0.8"
html-escape = "0.2"
tracing = { version = "0.1", features = ["log"] }
tracing-subscriber = { version = "0.3", features = ["fmt", "env-filter"] }
tracing-appender = "0.2"
